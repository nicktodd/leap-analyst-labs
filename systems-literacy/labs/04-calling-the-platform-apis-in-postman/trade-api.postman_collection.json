{
  "info": {
    "name": "LEAP Trading Platform APIs",
    "description": "Requests against trade-api.yaml and auth-api.yaml for LEAP Systems Analyst Week 6, Module 04. Works against the live platform (port 8080, auth on 3000) or the Prism mock (port 4010, auth mock on 4011). The Prefer headers select a response when the Prism mock is used; the live API ignores them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authUrl}}/auth/login",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns an access token (15 minutes) and a refresh token. The test script stores accessToken in the environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.test('Token stored', function () { pm.expect(body.accessToken).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/auth/me",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
