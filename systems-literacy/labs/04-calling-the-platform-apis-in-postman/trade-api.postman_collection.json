    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order (BUY)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"symbol\": \"ACME\",\n  \"side\": \"BUY\",\n  \"quantity\": 100,\n  \"price\": 25.5,\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set('lastKey', pm.environment.get('idempotencyKey'));",
                  "const b = pm.response.json();",
                  "if (b.orderId) { pm.environment.set('orderUuid', b.orderId.replace('ORD-', '')); }"
                ]
              }
            }
          ]
        },
